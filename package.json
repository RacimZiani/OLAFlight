{
  "name": "ola-flight",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Backend Ola Flight — chatbot Anthropic, CRM leads/devis, PDF, webhooks WhatsApp/Instagram, Calendly.",
  "engines": {
    "node": ">=18.18"
  },
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "railway:login": "npx @railway/cli login",
    "railway:link": "npx @railway/cli link",
    "railway:push-env": "node scripts/push-env-railway.mjs",
    "db:print-init": "node -e \"import('node:fs').then(fs=>console.log(fs.readFileSync('db/migrations/001_init.sql','utf8')))\"",
    "db:print-rls": "node -e \"import('node:fs').then(fs=>console.log(fs.readFileSync('db/migrations/002_rls.sql','utf8')))\"",
    "airports:build": "node scripts/build-airports-index.mjs",
    "dial-codes:build": "node scripts/build-dial-codes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "playwright": "^1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "serverless-http": "^3.2.0",
    "zod": "^3.25.76"
  }
}
