# ─── Anthropic (chatbot Ola) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=600

# ─── Serveur ──────────────────────────────────────────────────────────────
PORT=5179
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
# Utilisé pour les liens absolus (PDF inclus dans WhatsApp, notifs, etc.).
# En dev : http://localhost:5179. En prod : https://api.olaflight.com (par ex.).
PUBLIC_URL=http://localhost:5179

# ─── Stockage ─────────────────────────────────────────────────────────────
# sqlite (défaut, zéro setup, fichier data/ola-flight.db) | json (legacy) | supabase
STORAGE_DRIVER=sqlite
SQLITE_PATH=

# Activer en prod : exécuter db/migrations/001_init.sql + 002_rls.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (JWT cookie + bcrypt) ───────────────────────────────────────────
# JWT_SECRET : générer une chaîne aléatoire longue (>= 32 chars).
#   ex : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
SESSION_TTL=7d
COOKIE_SECURE=false   # true en prod (HTTPS)

# Compte admin auto-créé sur premier boot (table users vide).
# Si ADMIN_PASSWORD vide → le serveur génère un mot de passe random imprimé en log.
ADMIN_EMAIL=admin@olaflight.local
ADMIN_PASSWORD=
ADMIN_NAME=Seth

# Tokens optionnels X-Admin-Token (legacy, déprécié).
ADMIN_TOKENS=

# ─── Meta (WhatsApp Business + Instagram DM) ─────────────────────────────
# 1. Activer WhatsApp Business sur business.facebook.com → System User token
# 2. Webhook : https://<PUBLIC_URL>/api/webhooks/whatsapp
# 3. META_VERIFY_TOKEN : chaîne arbitraire (sera demandée à la config webhook)
# 4. META_APP_SECRET : "App Secret" du Meta App
META_APP_SECRET=
META_VERIFY_TOKEN=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

INSTAGRAM_TOKEN=
INSTAGRAM_PAGE_ID=

# ─── Calendly ────────────────────────────────────────────────────────────
# Phase 1 : juste CALENDLY_LINK (lien personnel statique) suffit.
# Phase 2 : ajouter CALENDLY_TOKEN + EVENT_TYPE_URI pour single-use links.
CALENDLY_LINK=
CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_WEBHOOK_KEY=

# ─── Notifications internes ──────────────────────────────────────────────
# Numéros WhatsApp (E.164 sans le "+") qui reçoivent les notifs nouveau lead.
# Ex : 33612345678,33687654321
DALSIM_WHATSAPP=
DEFAULT_CLOSER_WHATSAPP=
